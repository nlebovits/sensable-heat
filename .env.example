# Sensable Heat — Environment Variables
# Copy to .env.local and fill in values

# The LST collection URL lives in src/lib/config.ts, alongside the other
# data sources. It is public, so it needs no environment variable.

# Nominatim geocoding endpoint
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Admin boundaries PMTiles (not yet available from fieldmaps.io)
# See: https://data.fieldmaps.io/edge-matched/humanitarian/intl/
NEXT_PUBLIC_ADM_PMTILES=

# Basemap style URLs (using CartoCDN free tier)
NEXT_PUBLIC_BASEMAP_DARK=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
NEXT_PUBLIC_BASEMAP_LIGHT=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
